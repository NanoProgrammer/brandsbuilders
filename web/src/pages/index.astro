---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: 'Websites & Ad Management for Cleaning Companies — Calgary | BrandsBuilders',
  description: 'We build cleaning companies in Calgary a website and run their Google & Meta ads to bring in residential or commercial clients. Not happy in 30 days? We refund our work.',
  canonical: 'https://brandsbuilders.ca',
};

const examples = [
  { name: 'Vivia Cleaning', tag: 'Residential Cleaning', url: 'https://vivia-cleaing.vercel.app/' },
  { name: 'We Clean 4 U', tag: 'Residential & Commercial Cleaning', url: 'https://weclean4u-rho.vercel.app/' },
  { name: 'Cleaning Company', tag: 'Residential Cleaning', url: 'https://cleaning-business-drab.vercel.app/' },
];

const areas = ['Calgary', 'Airdrie', 'Cochrane', 'Chestermere', 'Okotoks'];
---

<Layout seo={seo}>

  <!-- ═══ HERO ═══ -->
  <section class="bg-white pt-14 pb-16 lg:pb-20">
    <div class="container mx-auto px-6 max-w-[920px] text-center">

      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gray-100 border border-gray-200 text-gray-600 text-sm font-semibold mb-8">
        <span class="w-2 h-2 rounded-full bg-green-500 shrink-0 animate-pulse"></span>
        Cleaning Companies · Calgary &amp; Area
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-[1.08] tracking-tight">
        We build your cleaning company a website
        <span class="text-orange-600"> and run the ads that fill it with jobs.</span>
      </h1>

      <p class="mt-7 text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        One offer, built specifically for cleaning businesses in Calgary and the surrounding area: a real website, plus Google &amp; Meta ads we create, edit, and run for you — aimed at the residential or commercial clients you actually want.
      </p>

      <p class="mt-4 text-xl text-gray-800 font-medium max-w-2xl mx-auto leading-relaxed">
        Not happy with the work in the first 30 days? We refund it. No arguments.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/apply"
          class="inline-flex px-9 py-4 rounded-lg font-semibold text-white bg-gray-900 hover:bg-gray-800 transition text-lg shadow-sm">
          Get my free growth plan →
        </a>
        <a href="https://cal.com/brandsbuilders/30-min" target="_blank" rel="noopener noreferrer"
          class="inline-flex px-9 py-4 rounded-lg font-semibold text-gray-700 border border-gray-300 hover:border-gray-400 transition text-lg">
          Book a 15-min call
        </a>
      </div>

      <p class="mt-5 text-sm text-gray-400">
        Website + ad management, bundled · 30-day guarantee on our work
      </p>

      <!-- stat row -->
      <div class="mt-14 grid grid-cols-1 sm:grid-cols-3 gap-5 max-w-3xl mx-auto">
        <div class="bg-gray-50 border border-gray-200 rounded-xl px-6 py-5 text-center">
          <div class="text-3xl font-bold text-gray-900">2-in-1</div>
          <div class="text-sm text-gray-500 mt-1">website built + ads run for you, one offer</div>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded-xl px-6 py-5 text-center">
          <div class="text-3xl font-bold text-orange-600">30 days</div>
          <div class="text-sm text-gray-500 mt-1">not happy with the work? we refund it</div>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded-xl px-6 py-5 text-center">
          <div class="text-3xl font-bold text-gray-900">Calgary</div>
          <div class="text-sm text-gray-500 mt-1">+ Airdrie, Cochrane, Chestermere, Okotoks</div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══ THE OFFER ═══ -->
  <section id="offer" class="bg-gray-900 text-white py-16">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold text-orange-400 uppercase tracking-wider mb-4">The offer</p>
        <h2 class="text-3xl sm:text-4xl font-bold leading-tight">
          Built for one thing: getting your cleaning company more clients.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-gray-800 rounded-xl p-7">
          <div class="w-10 h-10 rounded-full bg-orange-500 text-white font-bold flex items-center justify-center text-lg mb-5">1</div>
          <h3 class="font-bold text-lg mb-2">We build your website</h3>
          <p class="text-gray-300 leading-relaxed text-sm">
            A real, professional site for your cleaning company — not a Facebook page. Built to show homeowners or businesses exactly what you offer and make it easy to book.
          </p>
        </div>
        <div class="bg-gray-800 rounded-xl p-7">
          <div class="w-10 h-10 rounded-full bg-orange-500 text-white font-bold flex items-center justify-center text-lg mb-5">2</div>
          <h3 class="font-bold text-lg mb-2">We run your ads</h3>
          <p class="text-gray-300 leading-relaxed text-sm">
            We create, edit, and run the Google &amp; Meta ad campaigns on your behalf — targeted at homeowners or businesses in Calgary and the surrounding area actively looking for cleaning services.
          </p>
        </div>
        <div class="bg-gray-800 rounded-xl p-7">
          <div class="w-10 h-10 rounded-full bg-orange-500 text-white font-bold flex items-center justify-center text-lg mb-5">3</div>
          <h3 class="font-bold text-lg mb-2">You choose the focus</h3>
          <p class="text-gray-300 leading-relaxed text-sm">
            Residential clients, commercial contracts, or both — we build the site and target the ads around whichever side of the business you want to grow.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE GUARANTEE ═══ -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-6 max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-orange-700 text-sm font-semibold mb-6">
        30-Day Guarantee
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">
        If you're not happy in the first 30 days, we refund our work.
      </h2>
      <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto">
        That covers what you paid us for the website and the ad management. Ad spend you've paid directly to Google or Meta is separate — that money goes straight to the platforms, not to us, so it isn't part of the refund. We're upfront about that from day one.
      </p>
    </div>
  </section>

  <!-- ═══ TRUST STRIP ═══ -->
  <section class="bg-gray-50 py-14 border-y border-gray-200">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="grid sm:grid-cols-4 gap-5 text-center">
        {[
          { label: '30-Day Guarantee', note: 'Refund on our fee if you\'re not happy' },
          { label: 'Website + Ads Bundled', note: 'One offer, not a pile of add-ons' },
          { label: 'Calgary-Based', note: 'We know the local market' },
          { label: 'Direct Access', note: 'You talk to the person doing the work' },
        ].map(item => (
          <div class="bg-white border border-gray-200 rounded-xl px-4 py-5">
            <p class="font-bold text-gray-900 text-sm">{item.label}</p>
            <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">{item.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SEE IT LIVE ═══ -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900">See it live</h2>
        <p class="mt-3 text-gray-600 text-lg">Real cleaning company websites, built and running right now.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        {examples.map(ex => (
          <a href={ex.url} target="_blank" rel="noopener noreferrer"
            class="group bg-gray-50 border border-gray-200 rounded-xl p-6 hover:border-orange-300 hover:shadow-md transition block">
            <p class="text-xs text-orange-600 font-semibold uppercase tracking-wider mb-2">{ex.tag}</p>
            <p class="font-bold text-gray-900 text-lg mb-3">{ex.name}</p>
            <p class="text-sm text-gray-500 group-hover:text-orange-600 transition">View live site ↗</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/proof" class="text-sm text-gray-600 hover:text-gray-800 font-medium transition">See the full offer breakdown →</a>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICE AREA ═══ -->
  <section class="bg-gray-50 py-16 border-y border-gray-200">
    <div class="container mx-auto px-6 max-w-3xl text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Where we work</h2>
      <p class="text-gray-600 mb-6">Calgary and the surrounding area.</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        {areas.map(area => (
          <span class="bg-white border border-gray-200 text-gray-700 text-sm font-semibold px-4 py-2 rounded-full">{area}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ OBJECTIONS ═══ -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-6 max-w-3xl">
      <h2 class="text-3xl font-bold text-gray-900 text-center mb-10">Common questions</h2>
      <div class="space-y-4">
        {[
          { q: 'I don\'t have a website at all right now. Is that a problem?', a: 'No — that\'s exactly who this is built for. We build the website from scratch as part of the offer. You don\'t need anything in place before you start.' },
          { q: 'What does the 30-day guarantee actually cover?', a: 'If you\'re not happy with the website or how we\'re managing the ads within the first 30 days, we refund what you paid us for that work. Ad spend already paid directly to Google or Meta isn\'t part of that, since it never came to us.' },
          { q: 'Can I choose to only target residential or only commercial clients?', a: 'Yes. Tell us which side of the business you want to grow — residential, commercial, or both — and we build the site and target the ad campaigns around that.' },
          { q: 'Do you only work with cleaning companies in Calgary proper?', a: 'Calgary is the core, but we also cover the surrounding area — Airdrie, Cochrane, Chestermere, and Okotoks.' },
          { q: 'What\'s the cost?', a: 'That depends on your current setup and how much ad spend you want behind the campaigns. Book the 15-minute call and we\'ll walk you through it before you commit to anything.' },
        ].map(f => (
          <details class="bg-gray-50 border border-gray-200 rounded-xl p-5 group">
            <summary class="cursor-pointer font-semibold text-gray-900 flex justify-between items-center gap-4 text-sm">
              {f.q}
              <svg class="w-5 h-5 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 text-gray-600 text-sm leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section class="bg-gray-900 text-white py-20">
    <div class="container mx-auto px-6 max-w-3xl text-center">
      <p class="text-orange-400 font-semibold text-sm uppercase tracking-wider mb-4">15 minutes</p>
      <h2 class="text-3xl sm:text-4xl font-bold leading-tight mb-6">
        Every week without a real website and running ads is a week of jobs going to a competitor who has both.
      </h2>
      <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto leading-relaxed">
        15 minutes to walk through your business and tell you honestly what the website + ad management would look like for you — before you decide anything.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/apply"
          class="inline-flex px-10 py-4 rounded-lg font-semibold text-gray-900 bg-white hover:bg-gray-100 transition text-lg">
          Get my free growth plan →
        </a>
        <a href="https://cal.com/brandsbuilders/30-min" target="_blank" rel="noopener noreferrer"
          class="inline-flex px-10 py-4 rounded-lg font-semibold text-white border border-gray-700 hover:border-gray-500 transition text-lg">
          Book a 15-min call
        </a>
      </div>
      <p class="mt-5 text-sm text-gray-500">Website + ad management, bundled · 30-day guarantee on our work</p>
    </div>
  </section>

</Layout>
