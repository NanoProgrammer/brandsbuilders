---
import Layout from '../../layouts/Layout.astro';

const faqs = [
  {
    q: 'What exactly is included in the offer?',
    a: 'A custom-built website for your cleaning company, plus Google and/or Meta ad campaigns that we create, edit, and run on your behalf — targeted at residential clients, commercial contracts, or both, depending on what you want to grow.',
  },
  {
    q: 'What does the 30-day guarantee cover?',
    a: 'If you\'re not happy with the website or how we\'re managing the ads within the first 30 days, we refund what you paid us for that work. Ad spend you\'ve already paid directly to Google or Meta is separate and isn\'t part of the refund — that money goes straight to the ad platforms, not to us.',
  },
  {
    q: 'I don\'t have a website at all. Can I still start?',
    a: 'Yes — that\'s exactly who this is built for. We build the site from scratch as part of the offer. You don\'t need anything in place beforehand.',
  },
  {
    q: 'Can I focus only on residential or only on commercial clients?',
    a: 'Yes. Tell us which side of the business you want to grow — residential, commercial, or both — and we build the site and target the ad campaigns around that.',
  },
  {
    q: 'Who pays for the ad spend?',
    a: 'You do, directly to Google or Meta — that\'s separate from what you pay us for building the site and managing the campaigns. We\'ll walk through realistic ad budgets on the call.',
  },
  {
    q: 'How long until the website and ads are live?',
    a: 'Timelines depend on your specific setup, but we move quickly — we\'ll give you a clear timeline on the 15-minute call once we understand your business.',
  },
  {
    q: 'Do I own the website?',
    a: 'Yes, the site is built for you and is yours.',
  },
  {
    q: 'What areas do you serve?',
    a: 'Calgary is the core, plus the surrounding area — Airdrie, Cochrane, Chestermere, and Okotoks.',
  },
  {
    q: 'What does it cost?',
    a: 'It depends on your current setup and how much ad spend you want behind the campaigns. Book the 15-minute call and we\'ll walk you through it before you commit to anything.',
  },
  {
    q: 'What if my cleaning company is outside Calgary and area?',
    a: 'Book the call anyway and we\'ll tell you honestly whether it makes sense for your market.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const seo = {
  title: 'FAQ — Website & Ad Management for Cleaning Companies | BrandsBuilders',
  description: 'Common questions about the Calgary cleaning-business offer: website, ad management, the 30-day guarantee, and pricing.',
  canonical: 'https://brandsbuilders.ca/faq',
  schema: faqSchema,
};
---

<Layout seo={seo}>

  <section class="bg-white pt-16 pb-4 border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-3xl text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">Common questions</h1>
      <p class="text-gray-600 text-lg">Everything you'd want to know before booking a call.</p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="container mx-auto px-6 max-w-3xl">
      <div class="space-y-4">
        {faqs.map(item => (
          <details class="bg-gray-50 border border-gray-200 rounded-xl p-6 group">
            <summary class="cursor-pointer font-semibold text-gray-900 flex justify-between items-center gap-4">
              {item.q}
              <svg class="w-5 h-5 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-900 text-white py-16 text-center">
    <div class="container mx-auto px-6 max-w-2xl">
      <h2 class="text-3xl font-bold mb-3">Still have a question?</h2>
      <p class="text-gray-400 mb-8 text-lg">Book a 15-min call. We'll answer everything and tell you honestly if this fits your business.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/apply" class="inline-flex px-9 py-4 rounded-lg font-semibold text-gray-900 bg-white hover:bg-gray-100 transition text-lg">
          Get my free growth plan →
        </a>
        <a href="https://cal.com/brandsbuilders/30-min" target="_blank" rel="noopener noreferrer"
          class="inline-flex px-9 py-4 rounded-lg font-semibold text-white border border-gray-700 hover:border-gray-500 transition text-lg">
          Book a 15-min call
        </a>
      </div>
    </div>
  </section>

</Layout>
