---
import Layout from '../../layouts/Layout.astro';

const faqs = [
  {
    q: 'What exactly is a referral network?',
    a: 'It\'s a group of 4–5 non-competing businesses that already stand in front of your ideal client right before they need your service. For HVAC, that\'s plumbers and home inspectors. For roofing, it\'s adjusters and realtors. For restoration, it\'s plumbers and property managers. We identify those businesses in your market, recruit them as partners, and set up the relationship so they send jobs to you instead of whoever they happen to know.',
  },
  {
    q: 'How is this different from just asking for referrals?',
    a: '"Ask for referrals" is random. What we build is a system with specific partner types, a value exchange, and a follow-up cadence that keeps you top of mind. A plumber who agreed to send restoration leads your way and knows there\'s something in it for him is going to keep thinking of you — consistently. That\'s the difference between a one-off favour and a channel.',
  },
  {
    q: 'How many jobs can I realistically expect?',
    a: 'A partner who actively refers sends 12–15 jobs per year on average. With 4 active partners, that\'s ~60 referred jobs annually from a mature network. Early on, one or two partners will be more active than others. By month 6, you\'ll have a clear picture of your top performers.',
  },
  {
    q: 'How long until I see the first referral?',
    a: 'The fastest partners send a job within 2–4 weeks of onboarding. Most networks see their first few referrals within 60 days. A fully mature network — where partners think of you by default — takes 3–6 months.',
  },
  {
    q: 'Do I have to maintain this myself after you\'re done?',
    a: 'Yes — and that\'s intentional. We hand you a simple system: a monthly touchpoint template, a reciprocity structure, and a follow-up cadence you can run in under an hour a month. You own the network. No dependency on us, no retainer.',
  },
  {
    q: 'What if a partner stops sending referrals?',
    a: 'Relationships drift. We build in a reactivation protocol for exactly this — a sequence you run every quarter to re-engage dormant partners. And since you own the relationships, you can always recruit a replacement using the same outreach approach we hand you.',
  },
  {
    q: 'What does it cost?',
    a: 'The fee is discussed on the 15-min call. We\'ll walk you through what the network looks like for your niche — how many partners, what volume to expect — and then talk through the investment together. No pressure, no surprises.',
  },
  {
    q: 'What if I\'m not in HVAC, Roofing, or Restoration?',
    a: 'The referral network model works in any trade where another business already sees your client before the job is posted. Book a 15-min call and we\'ll tell you honestly whether your niche fits the model.',
  },
  {
    q: 'Do you build websites too?',
    a: 'Yes. Custom-coded websites for trades businesses — no templates, no monthly fees, live in 1–2 weeks. It\'s a separate service from the referral network. Ask about it on the call if relevant.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const seo = {
  title: 'FAQ — Referral Network Builder | BrandsBuilders',
  description: 'Common questions about how the BrandsBuilders referral network works, what results to expect, and whether it fits your trade.',
  canonical: 'https://brandsbuilders.ca/faq',
  schema: faqSchema,
};
---

<Layout seo={seo}>

  <section class="bg-white pt-16 pb-4 border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-3xl text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">Common questions</h1>
      <p class="text-gray-600 text-lg">Everything you'd want to know before booking a call.</p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="container mx-auto px-6 max-w-3xl">
      <div class="space-y-4">
        {faqs.map(item => (
          <details class="bg-gray-50 border border-gray-200 rounded-xl p-6 group">
            <summary class="cursor-pointer font-semibold text-gray-900 flex justify-between items-center gap-4">
              {item.q}
              <svg class="w-5 h-5 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-900 text-white py-16 text-center">
    <div class="container mx-auto px-6 max-w-2xl">
      <h2 class="text-3xl font-bold mb-3">Still have a question?</h2>
      <p class="text-gray-400 mb-8 text-lg">Book a 15-min call. We'll answer everything and tell you honestly if the model fits your niche.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/apply" class="inline-flex px-9 py-4 rounded-lg font-semibold text-gray-900 bg-white hover:bg-gray-100 transition text-lg">
          See which partners fit you →
        </a>
        <a href="https://cal.com/brandsbuilders/30-min" target="_blank" rel="noopener noreferrer"
          class="inline-flex px-9 py-4 rounded-lg font-semibold text-white border border-gray-700 hover:border-gray-500 transition text-lg">
          Book a 15-min call
        </a>
      </div>
    </div>
  </section>

</Layout>
