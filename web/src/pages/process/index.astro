---
import Layout from '../../layouts/Layout.astro';
const seo = { title: 'How It Works | BrandsBuilders', description: 'How the website + ad management offer for Calgary cleaning companies gets built and launched.', canonical: 'https://brandsbuilders.ca/process' };
---
<Layout seo={seo}>
<section class="bg-white py-20">
  <div class="container mx-auto px-6 max-w-4xl">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">How it works</h1>
    <p class="text-lg text-gray-600 mb-14">From application to a live website with ads running.</p>
    <div class="space-y-10">
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-orange-700 font-bold">1</div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-1">Apply &amp; fit check</h3>
          <p class="text-gray-600">You fill out the form — residential, commercial, or both, and your current situation. We confirm the offer fits before anything else happens.</p>
        </div>
      </div>
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-orange-700 font-bold">2</div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-1">Build the website</h3>
          <p class="text-gray-600">We design and build your cleaning company's website, with a clear way for visitors to request a quote or book.</p>
        </div>
      </div>
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-orange-700 font-bold">3</div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-1">Launch and manage your ads</h3>
          <p class="text-gray-600">Google and/or Meta campaigns go live, targeted at residential clients, commercial contracts, or both. Inquiries route straight to you.</p>
        </div>
      </div>
      <div class="flex gap-6 items-start">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-green-700 font-bold">4</div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-1">Report and optimize</h3>
          <p class="text-gray-600">We keep managing the campaigns — adjusting targeting and creative based on what's converting — and keep you posted on performance.</p>
        </div>
      </div>
    </div>
    <div class="mt-14 text-center">
      <a href="/apply" class="inline-flex px-8 py-3.5 rounded-lg font-semibold text-white bg-orange-600 hover:bg-orange-700 transition">Get my free growth plan →</a>
    </div>
  </div>
</section>
</Layout>
