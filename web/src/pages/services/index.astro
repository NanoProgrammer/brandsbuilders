---
import Layout from '../../layouts/Layout.astro';

const seo = {
  title: 'Referral Network Builder for Trades — BrandsBuilders',
  description: 'We identify the 4–5 businesses already seeing your ideal client and build the relationships that send them to you. One-time fee. No retainer. ~60 referred jobs/year.',
  canonical: 'https://brandsbuilders.ca/services',
};
---

<Layout seo={seo}>

  <!-- Header -->
  <section class="bg-white pt-16 pb-14 border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-orange-700 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-orange-500 shrink-0"></span>
        For HVAC · Roofing · Restoration
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 leading-tight mb-5">
        Referral Network Builder
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl leading-relaxed mb-6">
        We find the 4–5 businesses already standing in front of your ideal client — before the job is even posted — and we build the relationships that make them send it to you instead of your competitor.
      </p>
      <div class="flex flex-wrap items-center gap-4 mb-6">
        <div class="flex flex-wrap gap-2">
          <span class="bg-green-50 text-green-700 border border-green-200 text-xs font-semibold px-3 py-1 rounded-full">One-time fee</span>
          <span class="bg-green-50 text-green-700 border border-green-200 text-xs font-semibold px-3 py-1 rounded-full">No retainer</span>
          <span class="bg-orange-50 text-orange-700 border border-orange-200 text-xs font-semibold px-3 py-1 rounded-full">~60 jobs/year from a mature network</span>
        </div>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="/apply" class="inline-flex px-8 py-3.5 rounded-lg font-semibold text-white bg-gray-900 hover:bg-gray-800 transition">
          See which partners fit you →
        </a>
        <a href="https://cal.com/brandsbuilders/30-min" target="_blank" rel="noopener noreferrer"
          class="inline-flex px-8 py-3.5 rounded-lg font-semibold text-gray-700 border border-gray-300 hover:border-gray-400 transition">
          Book a 15-min call
        </a>
      </div>
    </div>
  </section>

  <!-- The Problem -->
  <section class="bg-gray-900 text-white py-16">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-orange-400 text-sm font-semibold uppercase tracking-wider mb-3">The real problem</p>
          <h2 class="text-3xl font-bold mb-4 leading-tight">
            The plumber finishing a water heater job already knows the homeowner needs a restoration company. He just hasn't met you yet.
          </h2>
          <p class="text-gray-400 leading-relaxed">
            Right now, that plumber is sending the job to whoever he happens to know. It isn't a better company than yours — it's just a more familiar name. That's the entire gap we close.
          </p>
        </div>
        <div class="space-y-4">
          {[
            { label: 'Cold ad lead', stats: ['Doesn\'t know you', 'Price-shops 4 competitors', 'Closes at 20–30%', 'High cost per job'] },
            { label: 'Referred lead', stats: ['Trusts you before calling', 'Rarely gets a second quote', 'Closes at 60–80%', 'Near-zero cost per job'] },
          ].map((col, i) => (
            <div class={`rounded-xl p-5 ${i === 0 ? 'bg-gray-800 border border-gray-700' : 'bg-orange-900/40 border border-orange-700/50'}`}>
              <p class={`text-xs font-bold uppercase tracking-wider mb-3 ${i === 0 ? 'text-gray-400' : 'text-orange-400'}`}>{col.label}</p>
              <ul class="space-y-2">
                {col.stats.map(s => (
                  <li class="text-sm text-gray-300 flex items-center gap-2">
                    <span class={i === 0 ? 'text-gray-600' : 'text-orange-400'}>→</span>
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">How we build your network</h2>
        <p class="mt-3 text-gray-600 text-lg">Three steps. Delivered once. Maintained by you with the tools we hand you.</p>
      </div>

      <div class="space-y-6">
        {[
          {
            n: '01',
            title: 'Map your referral ecosystem',
            body: 'We identify every type of business already in contact with your ideal client at the exact moment they need your service. For restoration that\'s plumbers, adjusters, property managers. For roofing it\'s adjusters, realtors, gutter companies. For HVAC it\'s plumbers, home inspectors, electricians.',
            note: 'Output: a shortlist of the 4–5 highest-leverage partner types for your market.',
          },
          {
            n: '02',
            title: 'Recruit and activate your partners',
            body: 'We reach out to real businesses in your area using proven outreach scripts. We explain the value exchange, handle the first conversation, and set up the referral agreement. By the end, you have 4–5 active partners who have agreed to send jobs your way.',
            note: 'Output: signed agreements, direct contacts, an active channel.',
          },
          {
            n: '03',
            title: 'Hand you the tools to keep it running',
            body: 'A referral network is only as strong as the relationships inside it. We give you a simple system to maintain those relationships without a retainer: a follow-up cadence, a monthly touchpoint template, and a reciprocity structure so your partners keep thinking of you first.',
            note: 'Output: you own the network. No dependency on us.',
          },
        ].map(step => (
          <div class="flex gap-6 items-start border border-gray-200 rounded-xl p-7 bg-gray-50">
            <div class="text-4xl font-black text-gray-200 leading-none shrink-0 w-12">{step.n}</div>
            <div>
              <h3 class="font-bold text-gray-900 text-lg mb-2">{step.title}</h3>
              <p class="text-gray-600 leading-relaxed text-sm mb-3">{step.body}</p>
              <p class="text-xs font-semibold text-orange-700 bg-orange-50 border border-orange-200 rounded-lg px-3 py-1.5 inline-block">{step.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="bg-gray-50 py-16 border-y border-gray-200">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-2">What you get</h2>
          <p class="text-gray-500 text-sm mb-6">One-time engagement. Everything included.</p>
          <ul class="space-y-3">
            {[
              'Full ecosystem map — every partner type relevant to your niche',
              'Outreach to real businesses in your market (we make the first contact)',
              '4–5 active partners recruited and onboarded',
              'Referral agreements in place before we wrap up',
              'Follow-up cadence so partners keep thinking of you',
              'Monthly touchpoint templates you can run yourself',
              'Reciprocity structure — how to send value back so the network stays active',
              '30-day check-in after delivery to troubleshoot and adjust',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="space-y-4">
          <div class="bg-white border border-gray-200 rounded-xl p-6">
            <h3 class="font-bold text-gray-900 mb-3">Who fits this</h3>
            <ul class="space-y-2">
              {[
                'HVAC companies with an active service area',
                'Roofing contractors with an active service area',
                'Restoration businesses (water, fire, mold)',
                'You have a good reputation and close the jobs you get',
                'You want predictable inbound — without ad dependency',
              ].map(item => (
                <li class="text-sm text-gray-700 flex items-start gap-2">
                  <span class="text-orange-500 mt-0.5">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-orange-50 border border-orange-200 rounded-xl p-5 text-sm text-orange-900 leading-relaxed">
            <strong>The fee is discussed on the 15-min call.</strong> We'll walk you through what the network looks like for your niche and whether it makes sense before you decide anything.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Math -->
  <section class="bg-white py-16">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold text-gray-900">Volume from a mature network</h2>
        <p class="mt-2 text-gray-500 text-sm">Each partner sends ~12–15 referrals per year. Four partners = ~60 jobs.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-5">
        {[
          { partners: '1 partner', jobs: '12–15 jobs/yr', note: 'One great relationship.' },
          { partners: '2 partners', jobs: '25–30 jobs/yr', note: 'A real channel.' },
          { partners: '4 partners', jobs: '~60 jobs/yr', note: 'A mature network.' },
        ].map(row => (
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 text-center">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">{row.partners}</p>
            <p class="text-2xl font-bold text-gray-900 mb-1">{row.jobs}</p>
            <p class="text-sm text-gray-500">{row.note}</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-gray-400 mt-4 text-center">Based on industry averages. Results depend on your market and follow-through.</p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-gray-900 text-white py-16 text-center">
    <div class="container mx-auto px-6 max-w-2xl">
      <h2 class="text-3xl font-bold mb-3">Ready to see which partners are already in your market?</h2>
      <p class="text-gray-400 mb-8 text-lg">The 15-min call is free. We'll tell you exactly which partner types fit your niche and what the network looks like before you decide anything.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/apply" class="inline-flex px-9 py-4 rounded-lg font-semibold text-gray-900 bg-white hover:bg-gray-100 transition text-lg">
          See which partners fit you →
        </a>
        <a href="https://cal.com/brandsbuilders/30-min" target="_blank" rel="noopener noreferrer"
          class="inline-flex px-9 py-4 rounded-lg font-semibold text-white border border-gray-700 hover:border-gray-500 transition text-lg">
          Book a 15-min call
        </a>
      </div>
    </div>
  </section>

</Layout>
