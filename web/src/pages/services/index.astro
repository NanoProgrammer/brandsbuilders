---
import Layout from '../../layouts/Layout.astro';

const seo = {
  title: 'Website + Ad Management for Cleaning Companies — Calgary | BrandsBuilders',
  description: 'A website built for your cleaning company, plus Google & Meta ads we run on your behalf to bring in residential or commercial clients. Backed by a 30-day guarantee.',
  canonical: 'https://brandsbuilders.ca/services',
};
---

<Layout seo={seo}>

  <!-- Header -->
  <section class="bg-white pt-16 pb-14 border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-orange-700 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-orange-500 shrink-0"></span>
        For Cleaning Companies · Calgary &amp; Area
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 leading-tight mb-5">
        Website + Ad Management, Bundled
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl leading-relaxed mb-6">
        We build your cleaning company a real website, then run the Google &amp; Meta ad campaigns on your behalf — pointed at residential clients, commercial contracts, or both.
      </p>
      <div class="flex flex-wrap items-center gap-4 mb-6">
        <div class="flex flex-wrap gap-2">
          <span class="bg-green-50 text-green-700 border border-green-200 text-xs font-semibold px-3 py-1 rounded-full">30-day guarantee</span>
          <span class="bg-green-50 text-green-700 border border-green-200 text-xs font-semibold px-3 py-1 rounded-full">Website + ads bundled</span>
          <span class="bg-orange-50 text-orange-700 border border-orange-200 text-xs font-semibold px-3 py-1 rounded-full">Calgary &amp; surrounding area</span>
        </div>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="/apply" class="inline-flex px-8 py-3.5 rounded-lg font-semibold text-white bg-gray-900 hover:bg-gray-800 transition">
          Get my free growth plan →
        </a>
        <a href="https://cal.com/brandsbuilders/30-min" target="_blank" rel="noopener noreferrer"
          class="inline-flex px-8 py-3.5 rounded-lg font-semibold text-gray-700 border border-gray-300 hover:border-gray-400 transition">
          Book a 15-min call
        </a>
      </div>
    </div>
  </section>

  <!-- The Problem -->
  <section class="bg-gray-900 text-white py-16">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-orange-400 text-sm font-semibold uppercase tracking-wider mb-3">The real problem</p>
          <h2 class="text-3xl font-bold mb-4 leading-tight">
            Someone in Calgary is searching for a cleaning company right now. If you don't have a real site and ads running, they're finding someone else.
          </h2>
          <p class="text-gray-400 leading-relaxed">
            Good reviews and word of mouth only reach people who already know you. New residential and commercial clients start with a search — and if there's nothing there to find, or nothing pointing them to you, the job goes to whoever showed up instead.
          </p>
        </div>
        <div class="space-y-4">
          {[
            { label: 'No website, no ads', stats: ['Invisible to new searches', 'Relies entirely on word of mouth', 'No way to target commercial accounts', 'Growth stalls at your current network'] },
            { label: 'Website + ads running', stats: ['Shows up when someone searches', 'Ads targeted to residential or commercial', 'New client inquiries land directly with you', 'Growth isn\'t capped by who you already know'] },
          ].map((col, i) => (
            <div class={`rounded-xl p-5 ${i === 0 ? 'bg-gray-800 border border-gray-700' : 'bg-orange-900/40 border border-orange-700/50'}`}>
              <p class={`text-xs font-bold uppercase tracking-wider mb-3 ${i === 0 ? 'text-gray-400' : 'text-orange-400'}`}>{col.label}</p>
              <ul class="space-y-2">
                {col.stats.map(s => (
                  <li class="text-sm text-gray-300 flex items-center gap-2">
                    <span class={i === 0 ? 'text-gray-600' : 'text-orange-400'}>→</span>
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">How it works</h2>
        <p class="mt-3 text-gray-600 text-lg">From application to a live website and running ads.</p>
      </div>

      <div class="space-y-6">
        {[
          {
            n: '01',
            title: 'Apply & fit check',
            body: 'Tell us about your business — residential, commercial, or both — and your current situation (no website, an outdated one, or a site with no ads running). We confirm the offer fits before anything else happens.',
            note: 'Output: a clear picture of what we\'ll build and target.',
          },
          {
            n: '02',
            title: 'We build your website',
            body: 'A custom-built site for your cleaning company — service pages, service area, and a clear way for someone to request a quote or book. Built to convert a visitor into an inquiry, not just look nice.',
            note: 'Output: a live website you own.',
          },
          {
            n: '03',
            title: 'We launch and manage your ads',
            body: 'We create, edit, and run the Google and/or Meta ad campaigns on your behalf, targeted at residential clients, commercial contracts, or both — whichever you want to grow. Every inquiry routes straight to you.',
            note: 'Output: ads live, client inquiries coming in.',
          },
          {
            n: '04',
            title: 'Report and optimize',
            body: 'We keep managing the campaigns, adjusting targeting and creative based on what\'s actually converting, and keep you posted on how it\'s performing.',
            note: 'Output: ongoing management, not a one-and-done launch.',
          },
        ].map(step => (
          <div class="flex gap-6 items-start border border-gray-200 rounded-xl p-7 bg-gray-50">
            <div class="text-4xl font-black text-gray-200 leading-none shrink-0 w-12">{step.n}</div>
            <div>
              <h3 class="font-bold text-gray-900 text-lg mb-2">{step.title}</h3>
              <p class="text-gray-600 leading-relaxed text-sm mb-3">{step.body}</p>
              <p class="text-xs font-semibold text-orange-700 bg-orange-50 border border-orange-200 rounded-lg px-3 py-1.5 inline-block">{step.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="bg-gray-50 py-16 border-y border-gray-200">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-2">What you get</h2>
          <p class="text-gray-500 text-sm mb-6">Website + ad management, one bundled offer.</p>
          <ul class="space-y-3">
            {[
              'A custom-built website for your cleaning company',
              'Service pages built around residential, commercial, or both',
              'A clear quote-request or booking path for visitors',
              'Google and/or Meta ad campaigns created and launched for you',
              'Ongoing ad management — targeting and creative adjusted over time',
              'Client inquiries routed straight to you',
              'Direct access to the person doing the work',
              '30-day guarantee on the work itself',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="space-y-4">
          <div class="bg-white border border-gray-200 rounded-xl p-6">
            <h3 class="font-bold text-gray-900 mb-3">Who this is for</h3>
            <ul class="space-y-2">
              {[
                'Cleaning companies in Calgary, Airdrie, Cochrane, Chestermere, or Okotoks',
                'Residential cleaning, commercial cleaning, or both',
                'You don\'t have a real website yet, or the one you have isn\'t bringing in new clients',
                'You want ad campaigns run for you instead of doing it yourself',
              ].map(item => (
                <li class="text-sm text-gray-700 flex items-start gap-2">
                  <span class="text-orange-500 mt-0.5">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-orange-50 border border-orange-200 rounded-xl p-5 text-sm text-orange-900 leading-relaxed">
            <strong>The cost is discussed on the 15-min call</strong> — it depends on your current setup and how much ad spend you want behind the campaigns. Ad spend itself is paid directly to Google/Meta and is separate from what you pay us.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Guarantee -->
  <section class="bg-white py-16">
    <div class="container mx-auto px-6 max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-orange-700 text-sm font-semibold mb-6">
        30-Day Guarantee
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-5">
        Not happy in the first 30 days? We refund our work.
      </h2>
      <p class="text-gray-600 leading-relaxed max-w-2xl mx-auto">
        That covers what you paid us for the website and the ad management. Ad spend already paid directly to Google or Meta isn't part of the refund — that money goes to the platforms, not to us, and we're upfront about that from the start.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-gray-900 text-white py-16 text-center">
    <div class="container mx-auto px-6 max-w-2xl">
      <h2 class="text-3xl font-bold mb-3">Ready to see what this looks like for your business?</h2>
      <p class="text-gray-400 mb-8 text-lg">The 15-min call is free. We'll walk through your current setup and tell you honestly what the website + ad management would look like.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/apply" class="inline-flex px-9 py-4 rounded-lg font-semibold text-gray-900 bg-white hover:bg-gray-100 transition text-lg">
          Get my free growth plan →
        </a>
        <a href="https://cal.com/brandsbuilders/30-min" target="_blank" rel="noopener noreferrer"
          class="inline-flex px-9 py-4 rounded-lg font-semibold text-white border border-gray-700 hover:border-gray-500 transition text-lg">
          Book a 15-min call
        </a>
      </div>
    </div>
  </section>

</Layout>
