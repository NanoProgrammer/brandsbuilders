---
import Layout from '../../layouts/Layout.astro';

const seo = {
  title: 'Apply — Referral Network Builder | BrandsBuilders',
  description: 'Tell us about your business. We\'ll map which partner types fit your niche and explain what the network looks like before you commit to anything.',
  canonical: 'https://brandsbuilders.ca/apply',
  noindex: false,
};
---

<Layout seo={seo}>

  <section class="bg-white pt-16 pb-20">
    <div class="container mx-auto px-6 max-w-3xl">

      <div class="mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-orange-700 text-xs font-semibold mb-5">
          <span class="w-2 h-2 rounded-full bg-orange-500 shrink-0"></span>
          Takes 3 minutes
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">
          See which partners fit you
        </h1>
        <p class="text-gray-600 text-lg leading-relaxed max-w-xl">
          Fill this out and we'll map your referral ecosystem — which partner types already see your ideal client and how many referrals a mature network produces in your niche.
        </p>
      </div>

      <form
        name="referral-network-apply"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thank-you"
        class="space-y-6"
      >
        <input type="hidden" name="form-name" value="referral-network-apply" />
        <input type="hidden" name="service" value="referral-network-builder" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-700 mb-1.5">Your name</label>
            <input id="name" name="name" type="text" required placeholder="John Smith"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition" />
          </div>
          <div>
            <label for="business" class="block text-sm font-semibold text-gray-700 mb-1.5">Business name</label>
            <input id="business" name="business" type="text" required placeholder="Smith Roofing Ltd."
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Email</label>
            <input id="email" name="email" type="email" required placeholder="john@smithroofing.ca"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1.5">Phone</label>
            <input id="phone" name="phone" type="tel" placeholder="403-555-0100"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition" />
          </div>
        </div>

        <div>
          <label for="industry" class="block text-sm font-semibold text-gray-700 mb-1.5">Your trade</label>
          <select id="industry" name="industry" required
            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition bg-white">
            <option value="" disabled selected>Select your trade</option>
            <option value="hvac">HVAC</option>
            <option value="roofing">Roofing</option>
            <option value="restoration">Restoration (water / fire / mold)</option>
            <option value="other">Other trades</option>
          </select>
        </div>

        <div>
          <label for="revenue" class="block text-sm font-semibold text-gray-700 mb-1.5">Annual revenue (approx.)</label>
          <select id="revenue" name="revenue" required
            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition bg-white">
            <option value="" disabled selected>Select a range</option>
            <option value="under-500k">Under $500k</option>
            <option value="500k-1m">$500k – $1M</option>
            <option value="1m-3m">$1M – $3M</option>
            <option value="3m-plus">$3M+</option>
          </select>
        </div>

        <div>
          <label for="location" class="block text-sm font-semibold text-gray-700 mb-1.5">City / service area</label>
          <input id="location" name="location" type="text" required placeholder="Calgary, AB"
            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition" />
        </div>

        <div>
          <label for="referrals" class="block text-sm font-semibold text-gray-700 mb-1.5">Do you currently get referrals from other businesses? How?</label>
          <textarea id="referrals" name="referrals" rows="3" placeholder="e.g. A plumber sends us water damage jobs occasionally. Nothing systematic."
            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition resize-none"></textarea>
        </div>

        <div>
          <label for="challenge" class="block text-sm font-semibold text-gray-700 mb-1.5">Biggest lead gen challenge right now</label>
          <textarea id="challenge" name="challenge" rows="3" placeholder="e.g. Spending $4k/mo on Google Ads and the quality is inconsistent."
            class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition resize-none"></textarea>
        </div>

        <button
          type="submit"
          id="apply-submit"
          class="w-full py-4 rounded-lg font-semibold text-white bg-gray-900 hover:bg-gray-800 transition text-base">
          Submit →
        </button>

        <p class="text-xs text-gray-400 text-center">We review every application and respond within 1 business day.</p>
      </form>

    </div>
  </section>

</Layout>

<script>
  document.getElementById('apply-submit')?.addEventListener('click', () => {
    if (typeof gtag !== 'undefined') {
      gtag('event', 'conversion', { send_to: 'AW-17710658719' });
    }
  });
</script>
