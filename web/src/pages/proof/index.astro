---
import Layout from '../../layouts/Layout.astro';

const seo = {
  title: 'See It Live — Cleaning Company Websites | BrandsBuilders',
  description: 'Real websites built for cleaning companies, plus what\'s included in the Calgary cleaning-business offer: website, ad management, and a 30-day guarantee.',
  canonical: 'https://brandsbuilders.ca/proof',
};

const examples = [
  { name: 'Vivia Cleaning', tag: 'Residential Cleaning', url: 'https://vivia-cleaing.vercel.app/', note: 'Custom-built site with service breakdown and a clear booking path.' },
  { name: 'We Clean 4 U', tag: 'Residential & Commercial Cleaning', url: 'https://weclean4u-rho.vercel.app/', note: 'Built to speak to both homeowners and commercial accounts.' },
  { name: 'Cleaning Company', tag: 'Residential Cleaning', url: 'https://cleaning-business-drab.vercel.app/', note: 'Fast, mobile-first site built to turn visitors into quote requests.' },
];
---

<Layout seo={seo}>

  <!-- Header -->
  <section class="bg-white pt-16 pb-12 border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-4xl text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">See it live.</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Real cleaning company websites, custom-built — not templates. These are running right now.
      </p>
    </div>
  </section>

  <!-- Portfolio -->
  <section class="bg-gray-50 py-20 border-b border-gray-200">
    <div class="container mx-auto px-6 max-w-5xl">

      <div class="text-center mb-12">
        <h2 class="text-2xl font-bold text-gray-900">Cleaning company websites we've built</h2>
        <p class="mt-2 text-gray-500 text-sm">Click through — these are live sites, not mockups.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {examples.map((p) => (
          <a href={p.url} target="_blank" rel="noopener noreferrer"
            class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-md hover:border-orange-200 transition block p-6">
            <p class="text-xs text-orange-600 font-semibold uppercase tracking-wider mb-2">{p.tag}</p>
            <p class="font-bold text-gray-900 text-lg mb-2">{p.name}</p>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">{p.note}</p>
            <p class="text-sm text-gray-500 group-hover:text-orange-600 transition">View live site ↗</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-2xl font-bold text-gray-900">What you're actually getting</h2>
        <p class="mt-2 text-gray-500 text-sm">Not just a website — the full offer.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { label: '30-Day Guarantee', note: 'Not happy with the work? We refund our fee.' },
          { label: 'Website + Ads Bundled', note: 'One offer covering both, not separate add-ons.' },
          { label: 'Calgary-Based', note: 'We know the local cleaning market and its suburbs.' },
          { label: 'Direct Access', note: 'You deal directly with the person doing the work.' },
        ].map(item => (
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 text-center">
            <p class="font-bold text-gray-900">{item.label}</p>
            <p class="text-sm text-gray-500 mt-2 leading-relaxed">{item.note}</p>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-400 text-center mt-10">
        We've also built websites for businesses in other industries — ask on the call if you'd like more examples.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gray-900 text-white py-16 text-center">
    <div class="container mx-auto px-6 max-w-2xl">
      <h2 class="text-3xl font-bold mb-3">Want yours to look like this?</h2>
      <p class="text-gray-400 mb-8 text-lg">15-minute call, no pressure. We'll tell you honestly what the website + ad management would look like for your business.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/apply" class="inline-flex px-9 py-4 rounded-lg font-semibold text-gray-900 bg-white hover:bg-gray-100 transition text-lg">
          Get my free growth plan →
        </a>
        <a href="https://cal.com/brandsbuilders/30-min" target="_blank" rel="noopener noreferrer"
          class="inline-flex px-9 py-4 rounded-lg font-semibold text-white border border-gray-700 hover:border-gray-500 transition text-lg">
          Book a 15-min call
        </a>
      </div>
    </div>
  </section>

</Layout>
